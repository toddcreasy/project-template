{%- from "template/_includes/env.jinja" import env_vars with context -%}
# Every env var this project reads. Values stay blank here.
# Tags after # drive scripts/setup_env.py and the pre-commit leak check:
#   secret   hidden input, value must never be committed
#   private  value must never be committed (personal info, account details)
#   default= value offered when you run setup_env.py
# Fill in or update .env with: python3 scripts/setup_env.py
{%- set ns = namespace(group="") %}
{%- for name, tag, default, group in env_vars %}
{%- if group != ns.group %}

# {{ group }}
{%- set ns.group = group %}
{%- endif %}
{{ name }}={% if tag != "public" or default %}  #{% if tag != "public" %} {{ tag }}{% endif %}{% if default %} default={{ default }}{% endif %}{% endif %}
{%- endfor %}
