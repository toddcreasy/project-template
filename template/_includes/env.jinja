{#- Every env var a generated project reads: (name, tag, default, group).
    tag: secret = hidden input, never committed; private = never committed; public = fine to commit. -#}
{%- set ns = namespace(vars=[]) -%}
{%- if use_aws -%}
  {%- set ns.vars = ns.vars + [
    ("AWS_PROFILE", "public", aws_profile, "AWS"),
    ("AWS_REGION", "public", aws_region, "AWS"),
    ("TF_VAR_alert_email", "private", "", "AWS"),
    ("TF_VAR_monthly_budget", "public", monthly_budget|string, "AWS"),
  ] -%}
  {%- if "s3" in aws_services -%}{%- set ns.vars = ns.vars + [("S3_BUCKET", "public", "", "AWS services")] -%}{%- endif -%}
  {%- if "aurora" in aws_services -%}{%- set ns.vars = ns.vars + [("DATABASE_SECRET_ARN", "private", "", "AWS services")] -%}{%- endif -%}
  {%- if "bedrock" in aws_services or "agentcore" in aws_services -%}
    {%- set ns.vars = ns.vars + [("MODEL_SMALL", "public", "", "AWS services"), ("MODEL_LARGE", "public", "", "AWS services")] -%}
  {%- endif -%}
  {%- if "agentcore" in aws_services -%}{%- set ns.vars = ns.vars + [("AGENT_RUNTIME_ARN", "private", "", "AWS services")] -%}{%- endif -%}
  {%- if "frontend" in aws_services -%}
    {%- set ns.vars = ns.vars + [("COGNITO_USER_POOL_ID", "public", "", "AWS services"), ("COGNITO_CLIENT_ID", "public", "", "AWS services")] -%}
  {%- endif -%}
  {%- if "batch" in aws_services -%}{%- set ns.vars = ns.vars + [("AWS_S3_WORKDIR", "public", "", "AWS services")] -%}{%- endif -%}
{%- endif -%}
{%- for raw in extra_env_vars.split(",") if raw.strip() -%}
  {%- set name = raw.strip() -%}
  {%- if name | regex_search("(KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|PRIVATE)") -%}{%- set tag = "secret" -%}
  {%- elif name | regex_search("(LEVEL|REGION|PORT|HOST|DEBUG|MODE|ENV|TIMEOUT|WORKERS)$") -%}{%- set tag = "public" -%}
  {%- else -%}{%- set tag = "private" -%}{%- endif -%}
  {%- set ns.vars = ns.vars + [(name, tag, "", "App")] -%}
{%- endfor -%}
{%- set env_vars = ns.vars -%}
