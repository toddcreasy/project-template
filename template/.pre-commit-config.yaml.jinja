# Runs before every commit. CI runs the same checks, so --no-verify only delays the failure.
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: check-added-large-files
        args: ["--maxkb=1000"]
      - id: detect-private-key
      - id: check-merge-conflict
      - id: check-yaml
      - id: end-of-file-fixer
      - id: trailing-whitespace

  - repo: local
    hooks:
      # Uses the installed gitleaks, installing it with brew if missing. Never skips.
      - id: gitleaks
        name: gitleaks
        entry: sh -c 'command -v gitleaks >/dev/null || { command -v brew >/dev/null && brew install gitleaks; } || { echo "gitleaks not found; brew install gitleaks"; exit 1; }; exec gitleaks git --pre-commit --redact --staged --verbose --config .gitleaks.toml'
        language: system
        pass_filenames: false
      - id: env-leaks
        name: values from .env in staged files
        entry: python3 scripts/check_env_leaks.py
        language: system
        pass_filenames: true
{%- if use_aws %}
      - id: terraform-fmt
        name: terraform fmt
        # Installs terraform from HashiCorp's tap if missing; Homebrew core is stuck at 1.5.7.
        entry: sh -c 'command -v terraform >/dev/null || { command -v brew >/dev/null && brew install hashicorp/tap/terraform; } || { echo "terraform not found; brew install hashicorp/tap/terraform"; exit 1; }; terraform fmt -check -recursive infra'
        language: system
        files: \.tf$
        pass_filenames: false
{%- endif %}
{%- if use_python %}

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.17.6
    hooks:
      - id: ruff-check
        args: ["--fix"]
      - id: ruff-format
{%- endif %}
